/**detail.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.detail-header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.detail-content {
  background-color: #fff;
  padding: 30rpx;
  flex: 1;
  overflow-y: auto;
}

.detail-footer {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.btn-action {
  width: 45%;
  background-color: #409EFF;
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  border: none;
}

.btn-action:active {
  background-color: #3a8ee6;
}
