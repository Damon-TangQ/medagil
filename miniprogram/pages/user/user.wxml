<!--user.wxml-->
<view class="container">
  <view class="user-header">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/default_avatar.png'}}" mode="aspectFill"></image>
    <text class="nickname">{{userInfo.nickName || '未登录'}}</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="handleMenuTap" data-type="profile">
      <text class="menu-title">个人资料</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="handleMenuTap" data-type="orders">
      <text class="menu-title">我的订单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="handleMenuTap" data-type="settings">
      <text class="menu-title">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="logout">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>
