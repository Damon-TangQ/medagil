# ==================== 应用配置 ====================
# 应用标题
VITE_APP_TITLE=Medagil AI管理后台

# 应用版本
VITE_APP_VERSION=1.0.0

# 应用环境 (development | production)
NODE_ENV=development

# ==================== API配置 ====================
# API基础URL
VITE_API_BASE_URL=http://localhost:5000/api

# API超时时间 (毫秒)
VITE_API_TIMEOUT=30000

# API重试次数
VITE_API_RETRY_TIMES=3

# ==================== 功能开关 ====================
# 是否启用Mock数据
VITE_ENABLE_MOCK=true

# 是否启用调试模式
VITE_DEBUG=true

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ==================== 认证配置 ====================
# Token存储键名
VITE_TOKEN_KEY=admin_token

# 用户信息存储键名
VITE_USER_KEY=admin_user

# Token刷新间隔 (毫秒)
VITE_TOKEN_REFRESH_INTERVAL=300000

# ==================== 权限配置 ====================
# 是否启用权限验证
VITE_ENABLE_PERMISSION=true

# 默认权限
VITE_DEFAULT_PERMISSIONS=dashboard,user,project,task,subscription

# ==================== 上传配置 ====================
# 上传文件大小限制 (MB)
VITE_UPLOAD_MAX_SIZE=10

# 允许上传的图片类型
VITE_UPLOAD_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# 允许上传的文件类型
VITE_UPLOAD_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ==================== 表格配置 ====================
# 默认每页显示数量
VITE_TABLE_PAGE_SIZE=10

# 每页显示数量选项
VITE_TABLE_PAGE_SIZES=10,20,50,100

# ==================== 导出配置 ====================
# 导出数据最大行数
VITE_EXPORT_MAX_ROWS=10000

# 导出文件类型
VITE_EXPORT_TYPES=xlsx,csv

# ==================== 其他配置 ====================
# 默认语言
VITE_DEFAULT_LANGUAGE=zh-CN

# 默认主题
VITE_DEFAULT_THEME=light

# 侧边栏折叠状态
VITE_SIDEBAR_COLLAPSED=false

# 标签页视图
VITE_TAGS_VIEW=true

# 固定头部
VITE_FIXED_HEADER=true

# 显示Logo
VITE_SHOW_LOGO=true

# 显示设置按钮
VITE_SHOW_SETTINGS=true

# ==================== 通知配置 ====================
# 是否启用消息通知
VITE_ENABLE_NOTIFICATION=true

# 通知显示时长 (毫秒)
VITE_NOTIFICATION_DURATION=3000

# ==================== 缓存配置 ====================
# 是否启用本地缓存
VITE_ENABLE_CACHE=true

# 缓存过期时间 (毫秒)
VITE_CACHE_EXPIRE=3600000

# ==================== 日志配置 ====================
# 是否启用操作日志
VITE_ENABLE_OPERATION_LOG=true

# 日志保留天数
VITE_LOG_RETENTION_DAYS=30
