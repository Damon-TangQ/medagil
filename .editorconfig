# EditorConfig: https://editorconfig.org
# 跨编辑器基础配置，统一缩进、换行、编码

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript / JavaScript / JSON / CSS / YAML 等
[*.{ts,tsx,js,jsx,json,jsonc,css,scss,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Go（gofmt 使用 tab，显示宽度 8 列）
[*.{go}]
indent_style = tab
indent_size = 8

# Python
[*.{py,pyi}]
indent_style = space
indent_size = 4

# Shell
[*.{sh,bash}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
