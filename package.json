{
  "name": "medagil",
  "private": true,
  "scripts": {
    "generate:api": "pnpm --filter @medagil/api-client generate",
    "lint:md": "markdownlint-cli \"**/*.md\" --ignore-path .markdownlintignore",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,scss,md,yml,yaml}\" \"packages/**/*.{ts,tsx,js,json,css,scss,md,yml,yaml}\" \"project/**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,css,scss,md,yml,yaml}\" \"packages/**/*.{ts,tsx,js,json,css,scss,md,yml,yaml}\" \"project/**/*.{md,yml,yaml}\""
  },
  "devDependencies": {
    "markdownlint-cli": "^0.38.0",
    "pnpm": "^8.0.0",
    "prettier": "^3.2.0"
  },
  "packageManager": "pnpm@8.15.0"
}
