{
  "name": "medagil",
  "private": true,
  "scripts": {
    "generate:api": "pnpm --filter @medagil/api-client generate",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,md}\" \"packages/**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,css,md}\" \"packages/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "pnpm": "^8.0.0",
    "prettier": "^3.2.0"
  },
  "packageManager": "pnpm@8.15.0"
}
