# ==================== 应用配置 ====================
# 应用标题
VITE_APP_TITLE=Medagil AI平台

# 应用版本
VITE_APP_VERSION=1.0.0

# 应用环境 (development | production)
NODE_ENV=development

# ==================== API配置 ====================
# API基础URL
VITE_API_BASE_URL=http://localhost:5000/api

# API超时时间 (毫秒)
VITE_API_TIMEOUT=30000

# API重试次数
VITE_API_RETRY_TIMES=3

# ==================== 功能开关 ====================
# 是否启用Mock数据
VITE_ENABLE_MOCK=true

# 是否启用调试模式
VITE_DEBUG=true

# ==================== 上传配置 ====================
# 上传文件大小限制 (MB)
VITE_UPLOAD_MAX_SIZE=5

# 允许上传的图片类型
VITE_UPLOAD_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ==================== 其他配置 ====================
# 默认语言
VITE_DEFAULT_LANGUAGE=zh-CN

# 默认主题
VITE_DEFAULT_THEME=light

# 每页显示数量
VITE_DEFAULT_PAGE_SIZE=12

# 最大每页显示数量
VITE_MAX_PAGE_SIZE=100
